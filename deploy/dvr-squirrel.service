# Example unit. Install the binary as /usr/local/bin/dvr-squirrel, put the DVR password into
# /etc/dvr-squirrel/dvr-password (mode 0600), and either set DVR_HOST and DVR_USER below or write
# /etc/dvr-squirrel/config.toml (optional; `dvr-squirrel generate-config` starts one).
# The release binary embeds the FFmpeg for the snapshots and extracts it into CacheDirectory; a binary without it
# (go install) uses ffmpeg from PATH when installed (apt install ffmpeg), else serves a placeholder picture.
[Unit]
Description=DVR to ONVIF bridge
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/dvr-squirrel
# No ExecStartPre=... --check-config: systemd 249 (Ubuntu 22.04) does not hand LoadCredential files to it, and the
# daemon checks the config at start anyway.
#Environment=DVR_HOST=dvr.example.lan DVR_USER=viewer
Restart=on-failure
# Where the embedded FFmpeg is extracted ($CACHE_DIRECTORY, /var/cache/dvr-squirrel).
CacheDirectory=dvr-squirrel
RestartSec=5

# The DVR password, readable by the service only, under $CREDENTIALS_DIRECTORY.
LoadCredential=dvr-password:/etc/dvr-squirrel/dvr-password
Environment=DVR_PASSWORD_FILE=%d/dvr-password

DynamicUser=yes
# Ports below 1024 (ONVIF 80, RTSP 554); nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: the interface lookups of the discovery and of the channels' MAC addresses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
